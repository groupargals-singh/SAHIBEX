# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment / secrets
.env
.env.*
!.env.example

# API keys / credentials
*.pem
*.key
*.secret
*secret*
*credential*

# Local databases / runtime data
data/android_companion_media_token
data/captures/
data/quarantine/
android_companion/build-media/
android_companion/manual-build/*.apk
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*

# Logs
*.log
logs/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build/package artifacts
build/
dist/
*.egg-info/

# Test/cache/coverage
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.bak
*.swp

# Local backup copies
*.backup-*
*.bak
*.bak*
*.backup

# Runtime audit data
*.jsonl

# Unusual temporary Python file
*.pym

# Android local SDK / Gradle state and generated packages
android_companion/local.properties
android_companion/.gradle/
android_companion/**/build/
android_companion/build-*/
android_companion/manual-build/
*.apk
*.aab

# Local runtime databases, device pairing/control tokens, and private provenance key
data/**/*.db
data/**/*.sqlite*
data/android_companion_*token
security/audit/.sahibex_provenance.key

# Historical scratch/backup copies are not source-of-truth files
*.pre
*.pre_*
*.pre-*
*.broken-copy
*.before_*
